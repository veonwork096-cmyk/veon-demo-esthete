---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { phone } from "../data/clinic";
const home = import.meta.env.BASE_URL;
---
<Base lang="uk" title="Сторінку не знайдено | Естет" description="Такої сторінки немає. Поверніться на головну ЕСТЕТ або зателефонуйте в клініку.">
  <section class="section not-found">
    <div class="container not-found__inner">
      <h1 class="not-found__title">Такої сторінки немає</h1>
      <p class="section__intro">Можливо, посилання застаріло. Поверніться на головну або запишіться за телефоном.</p>
      <div class="not-found__actions">
        <a class="btn btn--primary" href={phone.href}><Icon name="phone" />Записатися за телефоном</a>
        <a class="btn btn--outline" href={home}>На головну</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .not-found { min-height: 70svh; display: grid; align-items: center; }
  .not-found__inner { display: grid; gap: var(--s-3); justify-items: start; }
  .not-found__title { font-size: var(--fs-display); line-height: var(--lh-display); max-width: 14ch; }
  .not-found__actions { display: flex; flex-wrap: wrap; gap: var(--s-2); }
</style>
