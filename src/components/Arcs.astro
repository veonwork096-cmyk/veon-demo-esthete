---
// The logo's concentric arcs, open to the right like the «С» of ЕСТЕТ. Decorative only.
interface Props { class?: string; }
const { class: cls } = Astro.props;
const cx = 50, cy = 50, a = (40 * Math.PI) / 180;
const radii = [42.5, 45.5, 48.5];
const arc = (r: number) =>
  `M ${(cx + r * Math.cos(-a)).toFixed(2)} ${(cy + r * Math.sin(-a)).toFixed(2)} A ${r} ${r} 0 1 0 ${(cx + r * Math.cos(a)).toFixed(2)} ${(cy + r * Math.sin(a)).toFixed(2)}`;
---
<svg class:list={["arcs", "arcs--logo", cls]} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  {radii.map((r) => <path d={arc(r)} />)}
</svg>
