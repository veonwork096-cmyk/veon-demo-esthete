---
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import { soon } from "../data/clinic";

// Ratings: C-023 (Google 4.9 / 378), C-011 (top20.ua 4.8 / 188). Quotes verbatim: C-042 (Google widget on the client's homepage, Nov 2026).
const quotes = [
  { author: "Olha Yezhova", text: "Чудова клініка, дуже уважний лікар Олег Чабан та привітний персонал. Задоволена якістю отриманих послуг." },
  { author: "Oksana Dakhno", text: "Давно користуюся послугами стоматологічної клініки Естет. Цього разу була на прийомі у спеціаліста Олашин Інни Вікторівни. Вдячна лікарю за професійний підхід і вирішення проблеми." },
  { author: "Kristina Hocyljak", text: "Зверталися з сином, все чудово! Дбайливе і професійне ставлення, комфорт і турбота!" },
];
---
<Section id="reviews" class="section reviews" rec="R-406">
  <div class="container reviews__grid">
    <div class="reviews__score">
      <h2 class="reviews__title">
        <span class="reviews__figure tnum">4,9</span>
        <span class="reviews__caption">у Google — 378 відгуків</span>
      </h2>
      <p class="reviews__other">На top20.ua: 4,8 з 5, 188 відгуків</p>
      <FutureLink note={soon}>Всі відгуки</FutureLink>
    </div>
    <ul class="reviews__list" role="list">
      {quotes.map((q) => (
        <li>
          <figure class="quote">
            <blockquote class="quote__text"><p><span class="quote__mark" aria-hidden="true">«</span>{q.text}<span class="quote__mark" aria-hidden="true">»</span></p></blockquote>
            <figcaption class="quote__by">{q.author}, відгук у Google, листопад 2026</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</Section>
